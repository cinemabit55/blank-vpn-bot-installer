[Unit]
Description=Templar node availability monitor
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/bedolaga
ExecStart=/opt/bedolaga/.venv-templar-node/bin/python /opt/bedolaga/scripts/templar_node_monitor.py --config /var/lib/templar-node-test/monitor/monitor.yml
Nice=5

[Install]
WantedBy=multi-user.target
